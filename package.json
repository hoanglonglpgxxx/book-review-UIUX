{
  "name": "book-review-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:express": "tsx watch server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:express\"",
    "build": "next build",
    "start": "next start",
    "start:express": "tsx server/index.ts",
    "lint": "eslint .",
    "check": "tsc --noEmit",
    "ci": "npm run lint && npm run check && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "jose": "^6.2.2",
    "mongoose": "^9.3.1",
    "next": "16.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.19.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "typescript": "^5"
  }
}